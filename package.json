{
  "name": "ctrloja",
  "productName": "CtrLoja",
  "version": "1.0.0",
  "description": "Gestor de Agenda e Comunicacao da A.R.L.S. Uniao Fraternal Rolandense n 141 - UFR (GLP)",
  "main": "src/main/main.js",
  "author": {
    "name": "Engelogic / SensorLogic",
    "email": "engenharia@engelogic.com.br"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/teste-calendario.js && node --no-warnings test/teste-integracao.js",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "pack": "electron-builder --win --x64 --dir",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "node-cron": "^3.0.3",
    "qrcode": "^1.5.4"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "@electron/rebuild": "^4.2.0"
  },
  "build": {
    "appId": "br.com.engelogic.ctrloja",
    "productName": "CtrLoja",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/puppeteer*/**"
    ]
  }
}
