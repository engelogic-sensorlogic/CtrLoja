{
  "name": "ctrloja",
  "productName": "CtrLoja",
  "version": "1.0.0",
  "description": "Gestor de Agenda e Comunicacao da A.R.L.S. Uniao Fraternal Rolandense n 141 - UFR (GLP)",
  "main": "src/main/main.js",
  "author": {
    "name": "Engelogic / SensorLogic",
    "email": "engenharia@engelogic.com.br"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/teste-calendario.js && node --no-warnings test/teste-integracao.js && node --no-warnings test/teste-rotina.js && node --no-warnings test/teste-mobile.js && node --no-warnings test/teste-cripto.js && node --no-warnings test/teste-sincronizacao.js && node --no-warnings test/teste-presenca.js && node --no-warnings test/teste-publicacao.js && node --no-warnings test/teste-telas-celular.js",
    "modelos": "node ferramentas/sincronizar-modelos.js",
    "verificar-pacote": "node ferramentas/verificar-pacote.js",
    "publicar-dados": "node ferramentas/publicar-dados.js",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "pack": "electron-builder --win --x64 --dir",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "baileys": "7.0.0-rc13",
    "node-cron": "^3.0.3",
    "qrcode": "^1.5.4"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "@electron/rebuild": "^4.2.0",
    "jsdom": "^25.0.1"
  },
  "build": {
    "appId": "br.com.engelogic.ctrloja",
    "productName": "CtrLoja",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!test/**",
      "!ferramentas/**",
      "!docs/**",
      "!mobile/**"
    ],
    "extraFiles": [
      {
        "from": ".",
        "to": ".",
        "filter": [
          "Logo1.*",
          "Logo2.*",
          "build/icon.ico"
        ]
      }
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ]
  }
}
